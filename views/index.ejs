<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Blog</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <!-- main container -->
  <div class="container">
    
    <!-- header -->
    <header>
      <h1>Blog</h1>
      <p class="subtitle">Built with Node.js, Express, and EJS</p>
    </header>

    <!-- post form -->
    <section class="card">
      <h2>Create a New Blog Post</h2>
      <form action="/posts" method="POST">
        
        <div class="form-group">
          <label for="author">Author Name:</label>
          <input 
            type="text" 
            id="author" 
            name="author" 
            placeholder="Enter your name" 
            required
          >
        </div>

        <div class="form-group">
          <label for="title">Blog Title:</label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            placeholder="Enter a catchy title" 
            required
          >
        </div>

        <div class="form-group">
          <label for="content">Blog Content:</label>
          <textarea 
            id="content" 
            name="content" 
            rows="5" 
            placeholder="What would you like to write about today?" 
            required
          ></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Publish Post</button>
      </form>
    </section>

    <hr>

    <!-- posts list -->
    <section>
      <h2>Recent Blog Posts (<%= posts.length %>)</h2>

      <% if (posts.length === 0) { %>
        <div class="empty-state">
          <p>There are no blog posts yet! Use the form above to add the first post.</p>
        </div>
      <% } else { %>
        <% posts.forEach(function(post) { %>
          <article class="post-card">
            <div class="post-header">
              <h3 class="post-title"><%= post.title %></h3>
              <div class="post-meta">
                Written by <strong><%= post.author %></strong> on <span><%= post.createdAt %></span>
              </div>
            </div>

            <div class="post-content"><%= post.content %></div>

            <!-- buttons -->
            <div class="post-actions">
              <a href="/posts/<%= post.id %>/edit" class="btn btn-edit">Edit</a>

              <form action="/posts/<%= post.id %>/delete" method="POST" style="margin: 0;">
                <button 
                  type="submit" 
                  class="btn btn-delete" 
                  onclick="return confirm('Are you sure you want to delete this post?');"
                >
                  Delete
                </button>
              </form>
            </div>
          </article>
        <% }); %>
      <% } %>
    </section>

    <!-- footer -->
    <footer>
      <p>&copy; <%= new Date().getFullYear() %> My Barebones Blog. Made with Node.js & EJS.</p>
    </footer>
  </div>

</body>
</html>
