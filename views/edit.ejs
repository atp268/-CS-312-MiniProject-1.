<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Post - My Barebones Blog</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <!-- container -->
  <div class="container">
    <header>
      <h1>Edit Blog Post</h1>
      <p class="subtitle">Make your changes and save below</p>
    </header>

    <!-- edit form -->
    <section class="card">
      <h2>Editing: "<%= post.title %>"</h2>
      <form action="/posts/<%= post.id %>/edit" method="POST">
        
        <div class="form-group">
          <label for="author">Author Name:</label>
          <input 
            type="text" 
            id="author" 
            name="author" 
            value="<%= post.author %>" 
            required
          >
        </div>

        <div class="form-group">
          <label for="title">Blog Title:</label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            value="<%= post.title %>" 
            required
          >
        </div>

        <div class="form-group">
          <label for="content">Blog Content:</label>
          <textarea 
            id="content" 
            name="content" 
            rows="7" 
            required
          ><%= post.content %></textarea>
        </div>

        <!-- action buttons -->
        <div>
          <button type="submit" class="btn btn-primary">Save Changes</button>
          <a href="/" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </section>

    <footer>
      <p><a href="/" style="color: #2980b9; text-decoration: none;">&larr; Back to Home</a></p>
    </footer>
  </div>

</body>
</html>
